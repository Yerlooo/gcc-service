// GCC Web — database schema
// Provider: PostgreSQL 15+
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  ADMIN
  TECHNICIAN
}

enum BookingStatus {
  PENDING      // baru masuk, belum dikonfirmasi
  CONFIRMED    // dikonfirmasi admin, belum ada teknisi
  ASSIGNED     // teknisi sudah ditugaskan
  EN_ROUTE     // teknisi dalam perjalanan
  IN_PROGRESS  // sedang dikerjakan
  COMPLETED    // selesai
  CANCELLED    // dibatalkan
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  EWALLET
  MIDTRANS
}

enum BookingSource {
  WEBSITE
  WHATSAPP
  PHONE
}

enum ServiceUnit {
  UNIT
  POINT
  PACKAGE
  METER
}

enum PropertyType {
  RUMAH
  APARTEMEN
  KANTOR
  RUKO
  LAINNYA
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

// ─────────────────────────── Identity ───────────────────────────

model User {
  id               String              @id @default(uuid())
  name             String
  email            String              @unique
  phone            String?
  passwordHash     String
  role             Role                @default(TECHNICIAN)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  sessions         Session[]
  technician       TechnicianProfile?
  assignedBookings Booking[]           @relation("AssignedTechnician")
  statusChanges    BookingStatusHistory[]
  stockMovements   StockMovement[]
  auditLogs        AuditLog[]

  @@index([role, isActive])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TechnicianProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  zone           String
  specialties    String[]
  capacityPerDay Int      @default(4)
  isAvailable    Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Catalogue ───────────────────────────

model ServiceCategory {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services Service[]
}

model Service {
  id               String      @id @default(uuid())
  categoryId       String
  slug             String      @unique
  name             String
  shortDescription String
  description      String
  basePrice        Decimal     @db.Decimal(12, 2)
  unit             ServiceUnit @default(UNIT)
  durationMinutes  Int         @default(60)
  warrantyDays     Int         @default(30)
  isActive         Boolean     @default(true)
  isFeatured       Boolean     @default(false)
  sortOrder        Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  variants    ServiceVariant[]
  bookings    Booking[]
  testimonials Testimonial[]

  @@index([categoryId, isActive])
  @@index([isFeatured])
}

model ServiceVariant {
  id              String   @id @default(uuid())
  serviceId       String
  name            String
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([serviceId, name])
  @@index([serviceId, isActive])
}

// ─────────────────────────── Customers & orders ───────────────────────────

model Customer {
  id         String   @id @default(uuid())
  name       String
  phone      String   @unique
  email      String?
  address    String
  city       String
  district   String
  postalCode String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bookings Booking[]

  @@index([city, district])
}

model Booking {
  id               String         @id @default(uuid())
  code             String         @unique
  customerId       String
  serviceId        String
  variantId        String?
  technicianId     String?
  status           BookingStatus  @default(PENDING)
  paymentStatus    PaymentStatus  @default(UNPAID)
  paymentMethod    PaymentMethod?
  source           BookingSource  @default(WEBSITE)
  scheduledAt      DateTime
  slotLabel        String
  durationMinutes  Int
  propertyType     PropertyType   @default(RUMAH)
  address          String
  city             String
  district         String
  postalCode       String?
  notes            String?
  unitCount        Int            @default(1)
  basePrice        Decimal        @db.Decimal(12, 2)
  addOnTotal       Decimal        @default(0) @db.Decimal(12, 2)
  discount         Decimal        @default(0) @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
  paymentRef       String?
  paidAt           DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  customer      Customer               @relation(fields: [customerId], references: [id])
  service       Service                @relation(fields: [serviceId], references: [id])
  variant       ServiceVariant?        @relation(fields: [variantId], references: [id])
  technician    User?                  @relation("AssignedTechnician", fields: [technicianId], references: [id])
  statusHistory BookingStatusHistory[]
  stockMovements StockMovement[]
  testimonial   Testimonial?

  @@index([status, scheduledAt])
  @@index([technicianId, scheduledAt])
  @@index([customerId])
  @@index([createdAt])
  @@index([scheduledAt])
}

model BookingStatusHistory {
  id            String        @id @default(uuid())
  bookingId     String
  status        BookingStatus
  note          String?
  changedById   String?
  createdAt     DateTime      @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id])

  @@index([bookingId, createdAt])
}

model Testimonial {
  id           String   @id @default(uuid())
  bookingId    String?  @unique
  serviceId    String?
  customerName String
  customerMeta String?
  rating       Int      @default(5)
  content      String
  isPublished  Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([isPublished, isFeatured])
  @@index([serviceId])
}

// ─────────────────────────── Operations ───────────────────────────

model InventoryItem {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  category    String
  unit        String
  quantity    Int      @default(0)
  minQuantity Int      @default(0)
  costPrice   Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements StockMovement[]

  @@index([category])
  @@index([quantity])
}

model StockMovement {
  id          String            @id @default(uuid())
  itemId      String
  type        StockMovementType
  quantity    Int
  note        String?
  bookingId   String?
  createdById String?
  createdAt   DateTime          @default(now())

  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  booking   Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy User?         @relation(fields: [createdById], references: [id])

  @@index([itemId, createdAt])
  @@index([bookingId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}
