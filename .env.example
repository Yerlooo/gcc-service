# ─────────────────────────────────────────────────────────────
# gcc-web — monorepo environment map
# Copy each block into the matching app's .env file.
# ─────────────────────────────────────────────────────────────

# apps/api/.env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gcc_web?schema=public"
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET="replace-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="replace-with-another-openssl-rand-hex-32"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
SLOT_CAPACITY=3
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_TOKEN=
ADMIN_WHATSAPP=6281234567890
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
NEXT_PUBLIC_DEMO_MODE=1
